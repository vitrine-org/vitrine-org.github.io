---
// Starlight Header override: the same bar as the landing page, with Starlight's search inside.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteBar from './SiteBar.astro';

const lang = Astro.locals.starlightRoute.locale === 'it' ? 'it' : 'en';
const path = Astro.url.pathname;
const notFound = Astro.locals.starlightRoute.entry.slug === '404' || /404/.test(path);
const otherHref = notFound
	? lang === 'it' ? '/' : '/it/'
	: lang === 'it' ? path.replace(/^\/it(?=\/|$)/, '') || '/' : `/it${path}`;
---

<SiteBar lang={lang} otherHref={otherHref} current="docs">
	<Search slot="search" />
</SiteBar>
