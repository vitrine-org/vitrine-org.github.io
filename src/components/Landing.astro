---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/landing.css';
import { Image } from 'astro:assets';
import icon from '../assets/vitrine.svg';
import Icon from './Icon.astro';
import SiteBar from './SiteBar.astro';
import SiteFooter from './SiteFooter.astro';
import WinIcon from './WinIcon.astro';
import { languages, strings, type Lang } from '../i18n/landing';

// Real renders: each widget drawn by `vitrine render --backdrop` over a crop of an original
// wallpaper, then composited onto it at its grid cell (light and dark, en and it).
const renders = import.meta.glob<{ default: ImageMetadata }>('../assets/renders/*.webp', { eager: true });
const shot = (name: string) => renders[`../assets/renders/${name}.webp`].default;

interface Props {
	lang: Lang;
}

const lang = Astro.props.lang;
const t = strings[lang];
const docs = `${t.base}docs/`;
const gh = 'https://github.com/vitrine-org/vitrine';
const wide = '(min-width: 1200px) 1152px, calc(100vw - 32px)';
const half = '(min-width: 900px) 560px, calc(100vw - 32px)';
---

<!doctype html>
<html lang={t.htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={t.description} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#f4f4f3" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
		<link rel="alternate" hreflang="en" href="https://vitrine-org.github.io/" />
		<link rel="alternate" hreflang="it" href="https://vitrine-org.github.io/it/" />
		<meta property="og:title" content={t.title} />
		<meta property="og:description" content={t.description} />
		<script is:inline>
			try {
				const s = localStorage.getItem('starlight-theme');
				if (s === 'light' || s === 'dark') document.documentElement.dataset.theme = s;
			} catch {}
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const h = document.documentElement;
				h.classList.add('anim');
				setTimeout(() => { if (!h.classList.contains('ready')) h.classList.remove('anim'); }, 4000);
			}
		</script>
	</head>
	<body>
		<header class="site-header">
			<SiteBar lang={lang} current="home" />
		</header>

		<main>
			<section class="hero container grid">
				<a class="pill glass" href={`${t.base}packs/`} data-intro><Icon name="building-store" size={16} />{t.pill}</a>
				<h1 data-intro>{t.h1}</h1>
				<p class="lead" data-intro>{t.lead}</p>
				<div class="actions" data-intro>
					<a class="button primary" href={`${docs}getting-started/install/`}><Icon name="arrow-right" />{t.primary}</a>
					<a class="button glass" href={gh}><Icon name="brand-github" />{t.secondary}</a>
				</div>
				<p class="release" data-intro>{t.release}</p>

				<div class="stage" data-intro-stage>
					<div class="desk" data-tilt>
						<div class="wall" data-depth="1">
							<Image class="shot-light" src={shot(`hero-${lang}-light`)} alt={t.desk.alt} widths={[800, 1280, 1800, 2304]} sizes={wide} loading="eager" fetchpriority="high" />
							<Image class="shot-dark" src={shot(`hero-${lang}-dark`)} alt={t.desk.alt} widths={[800, 1280, 1800, 2304]} sizes={wide} loading="eager" />
						</div>
						<div class="layer icons" data-depth="0.4" aria-hidden="true">
							{t.desk.icons.map((label, i) => (
								<div class="dicon">
									<WinIcon name={(['pc', 'bin', 'documents', 'text'] as const)[i]} />
									<span class="dlabel">{label}</span>
								</div>
							))}
						</div>
						<div class="taskbar" data-depth="0.15" aria-hidden="true">
							<div class="tb-center">
								<span class="tb-app"><WinIcon name="start" /></span>
								<span class="tb-search"><Icon name="search" />{t.desk.search}</span>
								<span class="tb-app tb-search-icon"><Icon name="search" /></span>
								<span class="tb-app"><WinIcon name="explorer" /></span>
								<span class="tb-app"><WinIcon name="terminal" /></span>
								<span class="tb-app"><WinIcon name="settings" /></span>
								<span class="tb-app running"><img src={icon.src} alt="" /></span>
							</div>
							<div class="tb-tray">
								<Icon name="chevron-up" />
								<span class="tb-tray-icons"><Icon name="wifi" /><Icon name="volume" /><Icon name="battery-3" /></span>
								<span class="tb-clock" data-locale={t.locale}><span data-tray-time>00:00</span><span data-tray-date>01/01/2026</span></span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="feature container grid">
				<div class="feature-text" data-reveal>
					<h2>{t.layers.h}</h2>
					<p>{t.layers.p}</p>
					<a href={`${docs}architecture/`}><Icon name="stack-2" />{t.layers.link}</a>
				</div>
				<div class="visual stack" aria-hidden="true" data-stack>
					{t.layers.labels.map((label, i) => (
						<div class={`plane-wrap pw-${i}`} data-plane={i}>
							<div class={`plane plane-${i}`}>
								{i === 1 && (<><b></b><b></b><b></b></>)}
								{i === 2 && (<><s></s><s></s><s></s></>)}
							</div>
							<span class="plane-label">{label}</span>
						</div>
					))}
				</div>
			</section>

			<section class="feature reverse container grid">
				<div class="feature-text" data-reveal>
					<h2>{t.glass.h}</h2>
					<p>{t.glass.p}</p>
					<a href={`${docs}guides/glass-and-legibility/`}><Icon name="blur" />{t.glass.link}</a>
				</div>
				<figure class="visual split" data-split>
					<Image class="split-light" src={shot(`conky-${lang}-light`)} alt={t.glass.alt} widths={[600, 1100, 1600]} sizes={half} />
					<Image class="split-dark" src={shot(`conky-${lang}-dark`)} alt="" widths={[600, 1100, 1600]} sizes={half} />
					<figcaption><span>{t.glass.light}</span><span>{t.glass.dark}</span></figcaption>
				</figure>
			</section>

			<section class="feature container grid">
				<div class="feature-text" data-reveal>
					<h2>{t.edit.h}</h2>
					<p>{t.edit.p}</p>
					<a href={`${docs}getting-started/install/`}><Icon name="layout-grid" />{t.edit.link}</a>
				</div>
				<div class="visual board" aria-hidden="true" data-board>
					<div class="win" data-win><i></i><i></i><i></i></div>
					<div class="edit-bar glass"><span><Icon name="plus" size={14} />{t.edit.add}</span><span class="done">{t.edit.done}</span></div>
					<div class="tile tile-a acrylic" data-tile></div>
					<div class="tile tile-b acrylic" data-tile></div>
					<div class="tile tile-c acrylic editing" data-tile><i class="handle"></i></div>
					<p class="edit-hint">{t.edit.hint}</p>
				</div>
			</section>

			<section class="feature reverse container grid">
				<div class="feature-text" data-reveal>
					<h2>{t.panel.h}</h2>
					<p>{t.panel.p}</p>
					<a href={`${docs}getting-started/install/`}><Icon name="adjustments" />{t.panel.link}</a>
				</div>
				<div class="visual panel-shot">
					<Image class="panel-img" src={shot(`panel-${lang}`)} alt={t.panel.alt} widths={[600, 1225]} sizes={half} />
					<ul class="menu" aria-label={t.panel.menuLabel}>
						{t.panel.menu.map((label, i) => (
							<>
								{(i === 4 || i === 7) && <li class="sep" role="separator"></li>}
								<li class:list={{ check: i === 5 }}>
									<Icon name={['plus', 'layout-grid-add', 'layout-dashboard', 'settings', 'player-pause', 'check', 'building-store', 'power'][i]} size={16} />
									<span>{label}</span>
									{i === 1 && <Icon name="chevron-right" size={14} />}
								</li>
							</>
						))}
					</ul>
				</div>
			</section>

			<section class="showcase container">
				<div class="show-head" data-reveal>
					<p class="eyebrow">{t.vega.eyebrow}</p>
					<h2>{t.vega.h}</h2>
					<p>{t.vega.p}</p>
					<a class="text-link" href={`${t.base}packs/#dev.vitrine.vega`}><Icon name="building-store" />{t.vega.link}</a>
				</div>
				<figure class="board-shot">
					<Image class="shot-light" src={shot(`vega-${lang}-light`)} alt={t.vega.alt} widths={[800, 1300, 1808]} sizes={wide} />
					<Image class="shot-dark" src={shot(`vega-${lang}-dark`)} alt={t.vega.alt} widths={[800, 1300, 1808]} sizes={wide} />
				</figure>
				<ul class="chips">
					{t.vega.widgets.map((w) => <li>{w}</li>)}
				</ul>
			</section>

			<section class="showcase container">
				<div class="show-head" data-reveal>
					<p class="eyebrow">{t.themes.eyebrow}</p>
					<h2>{t.themes.h}</h2>
					<p>{t.themes.p}</p>
					<a class="text-link" href={`${docs}themes/create-a-theme/`}><Icon name="palette" />{t.themes.link}</a>
				</div>
				<ul class="themes">
					{t.themes.items.map((th) => (
						<li>
							<a href={`${t.base}packs/#dev.vitrine.${th.id}`} aria-label={`${th.name}: ${t.themes.view}`}>
								<Image src={shot(`theme-${th.id}-${lang}`)} alt={t.themes.alt(th.name)} widths={[600, 1232]} sizes="(min-width: 900px) 560px, calc(100vw - 32px)" />
								<span class="theme-text"><b>{th.name}</b><span>{th.note}</span></span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="feature container grid">
				<div class="feature-text" data-reveal>
					<h2>{t.jsx.h}</h2>
					<p>{t.jsx.p}</p>
					<a href={`${docs}getting-started/first-widget/`}><Icon name="code" />{t.jsx.link}</a>
				</div>
				<div class="visual code-wrap" data-code>
					<pre class="code glass" aria-label={t.jsx.codeLabel}><code><span class="ln"><span class="k">import</span> {'{'} formatDate, mount, useClock {'}'} <span class="k">from</span> <span class="s">"@vitrine/sdk"</span>;</span>
<span class="ln"> </span>
<span class="ln"><span class="k">function</span> <span class="f">Clock</span>() {'{'}</span>
<span class="ln">  <span class="k">const</span> now = <span class="f">useClock</span>(<span class="s">"minute"</span>);</span>
<span class="ln">  <span class="k">return</span> (</span>
<span class="ln">    <span class="t">&lt;view</span> style={'{{'} padding: <span class="n">16</span>, borderRadius: <span class="n">12</span>,</span>
<span class="ln">      backdropFilter: <span class="s">"blur(16px) saturate(1.6)"</span> {'}}'}<span class="t">&gt;</span></span>
<span class="ln">      <span class="t">&lt;text</span> style={'{{'} fontSize: <span class="n">40</span>, color: <span class="s">"#fff"</span> {'}}'}<span class="t">&gt;</span></span>
<span class="ln">        {'{'}<span class="f">formatDate</span>(<span class="f">now</span>(), <span class="s">"HH:mm"</span>){'}'}</span>
<span class="ln">      <span class="t">&lt;/text&gt;</span></span>
<span class="ln">    <span class="t">&lt;/view&gt;</span></span>
<span class="ln">  );</span>
<span class="ln">{'}'}</span>
<span class="ln"> </span>
<span class="ln"><span class="f">mount</span>(() =&gt; <span class="t">&lt;Clock /&gt;</span>);</span></code></pre>
					<div class="mini acrylic" aria-hidden="true"><span data-clock="hm">12:41</span></div>
				</div>
			</section>

			<section class="feature reverse container grid">
				<div class="feature-text" data-reveal>
					<h2>{t.power.h}</h2>
					<p>{t.power.p}</p>
					<a href={`${docs}guides/performance/`}><Icon name="bolt" />{t.power.link}</a>
				</div>
				<div class="visual repaint glass" aria-hidden="true">
					<div class="repaint-clock">
						<span data-part="hm">12:41</span><span class="sec" data-part="s">:07</span>
					</div>
					<p class="caption"><i></i>{t.power.caption}</p>
				</div>
			</section>

			<section class="cta container grid">
				<div class="cta-card glass" data-reveal>
					<div class="cta-text">
						<p class="eyebrow">{t.store.eyebrow}</p>
						<h2>{t.store.h}</h2>
						<p>{t.store.p}</p>
						<div class="actions">
							<a class="button primary" href={`${t.base}packs/`}><Icon name="building-store" />{t.store.cta}</a>
							<a class="button glass" href="https://github.com/vitrine-org/store#add-your-pack"><Icon name="upload" />{t.store.publish}</a>
						</div>
					</div>
					<div class="cta-langs">
						<h3>{t.langs.h}</h3>
						<p>{t.langs.p}</p>
						<ul class="langs">
							{languages.map((l) => <li lang={l.code}>{l.name}</li>)}
						</ul>
						<a class="text-link" href={`${docs}guides/localisation/`}><Icon name="language" />{t.langs.link}</a>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter lang={lang} />

		<script>
			import '../scripts/landing';
		</script>
	</body>
</html>
